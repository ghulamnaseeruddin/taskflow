# Copy this file to .env for local development (and never commit the real .env)

# A long random string — generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Leave unset to use local SQLite. In production, set to your Postgres URL, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# "production" enables secure cookies (requires HTTPS)
FLASK_ENV=development

PORT=5000
